{
  "name": "arcnest",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "clean:next": "node scripts/clean-next-cache.js",
    "dev:clean": "node scripts/clean-next-cache.js && next dev",
    "socket:dev": "node socket-server.js",
    "socket:start": "node socket-server.js",
    "build": "next build",
    "start": "node -e \"process.env.NODE_ENV='production'; require('./server.js')\"",
    "lint": "next lint",
    "contracts:compile": "hardhat compile",
    "contracts:deploy:arc": "hardhat run scripts/deploy-access-pass.js --network arcTestnet",
    "contracts:set-uris:arc": "hardhat run scripts/set-access-pass-uris.js --network arcTestnet",
    "contracts:clear-old-passes": "node scripts/clear-old-access-passes.js"
  },
  "dependencies": {
